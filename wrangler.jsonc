{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baygrub",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baygrub-reviews"
    }
  ]
}
